<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешение на доступ к интернету (для API запросов) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GameApp"
        tools:targetApi="31">

        <!-- Splash Screen - стартовый экран -->
        <activity
            android:name=".presentation.screens.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Welcome Screen -->
        <activity android:name=".presentation.screens.WelcomeActivity" />

        <!-- Registration Screen -->
        <activity android:name=".presentation.screens.RegistrationActivity" />

        <!-- Login Screen -->
        <activity android:name=".presentation.screens.LoginActivity" />

        <!-- Landing Screen (главный экран) -->
        <activity android:name=".presentation.screens.LandingActivity" />

        <!-- Schedule Game Screen -->
        <activity android:name=".presentation.screens.ScheduleGameActivity" />

        <!-- Success Screen -->
        <activity android:name=".presentation.screens.SuccessActivity" />

    </application>

</manifest>